<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>turtle_interfaces</name>
  <version>0.1.0</version>
  <description>
    문제 6 — turtlesim 과제용 커스텀 인터페이스(.msg / .srv / .action) 전용 패키지.
    노드 코드는 한 줄도 들어 있지 않습니다. "정의만 담는 패키지" 입니다.
  </description>
  <maintainer email="jje5976@gmail.com">조은</maintainer>
  <license>Apache-2.0</license>

  <!-- 빌드 도구: CMake 기반 ament + rosidl 코드 생성기 -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!-- WaypointList.msg 가 std_msgs/Header 를 포함하므로 std_msgs 가 필요합니다. -->
  <depend>std_msgs</depend>
  <!-- .action 파일은 내부적으로 action_msgs(GoalInfo, GoalStatus 등) 를 사용합니다. -->
  <depend>action_msgs</depend>

  <!-- 생성된 인터페이스를 런타임에 로드하기 위한 의존 (Python import 시 필요) -->
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- 이 줄이 있어야 ros2 interface list / show 가 이 패키지를 인터페이스 패키지로 인식합니다. -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
